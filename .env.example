# FitTrack Server-Side Secrets Configuration (.env.example)
# Do not commit your real .env file. Real keys are kept safe in server environment.

# 1. Google Gemini Multimodal Vision API (Nutrition, Image Analysis & Coaching)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Calisthenics Exercise Library API
CALISTHENICS_API_KEY=your_calisthenics_api_key_here

# 3. Gym & Resistance RapidAPI Key
RAPIDAPI_GYM_KEY=your_rapidapi_key_here

# 4. Neon Serverless PostgreSQL Database Connection String
# Get your connection string from the Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

PORT=5000
