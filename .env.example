# 1. DATABASE: Neon Serverless PostgreSQL
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION: Clerk
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# 3. TRANSACTIONAL EMAILS: Resend (Monday Weigh-In & Progress Digests)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"

# 4. OBJECT STORAGE: Cloudflare R2 (Zero-Egress Food Photos & Physique Snaps)
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="fittrack-media"
R2_PUBLIC_DOMAIN="https://pub-YOUR-BUCKET-ID.r2.dev"
VITE_R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
VITE_R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
VITE_R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
VITE_R2_BUCKET_NAME="fittrack-media"
VITE_R2_PUBLIC_DOMAIN="https://pub-YOUR-BUCKET-ID.r2.dev"

# 5. ARTIFICIAL INTELLIGENCE: Google Gemini Multimodal Vision & AI Coach
GEMINI_API_KEY="your_gemini_api_key_here"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# 6. APPLICATION PORTS & URL
PORT=3000
VITE_APP_URL="https://fittrack-blue-delta.vercel.app"
